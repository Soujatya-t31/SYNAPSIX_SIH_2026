# Copy this file to ".env" (same folder) and fill in real values to enable
# actual password-reset emails. Without this file, the app still works —
# forgot-password just shows the reset token on screen instead of emailing it.

# ---- Gmail setup ----
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password (choose "Mail"): https://myaccount.google.com/apppasswords
# 3. Paste the 16-character code below as SMTP_APP_PASSWORD (NOT your real Gmail password)

SMTP_EMAIL=youraddress@gmail.com
SMTP_APP_PASSWORD=your16charapppassword
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Base URL used to build the clickable link in the reset email.
# Change this if you deploy somewhere other than localhost.
APP_BASE_URL=http://localhost:8000

# ---- Database (optional) ----
# Leave unset for local dev: the app uses a local SQLite file (backend/infra.db),
# zero setup needed. Set this to a real Postgres connection string to switch to
# a shared, persistent database — required once you deploy, so every device/
# teammate hitting the deployed backend sees the same reports instead of each
# machine having its own separate local file.
#
# Free hosted Postgres options: neon.tech, supabase.com, or Render's free
# Postgres tier. They all give you a connection string that looks like:
#   postgresql://user:password@host/dbname
#
# DATABASE_URL=postgresql://user:password@host/dbname

# ---- YOLO relevance-check model (optional) ----
# The "is this actually a selfie, not the claimed issue" check runs a real
# YOLOv8 model, loaded locally in this backend process from the bundled
# weights file at backend/models/yolov8n.pt. No setup or env var needed —
# if the weights file is present (it's included in the repo), the real model
# is used automatically. If it's ever missing and can't be downloaded (e.g.
# no internet access), the app still works fine — it just falls back to a
# local OpenCV color heuristic for the selfie check instead.

